{
  "name": "@netra/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "bundle": "mkdir -p /tmp/netra-lambda-bundle && npx esbuild src/lambda.ts --bundle --platform=node --target=node22 --format=cjs --external:@aws-sdk/client-dynamodb --external:@aws-sdk/lib-dynamodb --external:@aws-sdk/client-eventbridge --external:@aws-sdk/client-s3 --outfile=/tmp/netra-lambda-bundle/lambda.js",
    "deploy:lambda": "npm run bundle && cd /tmp/netra-lambda-bundle && zip -q lambda.zip lambda.js && AWS_PROFILE=netra aws lambda update-function-code --function-name netra-prod-api --zip-file fileb://lambda.zip --region eu-north-1 --query CodeSize --output text",
    "env:restore": "node scripts/restore-env.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.687.0",
    "@aws-sdk/client-eventbridge": "^3.687.0",
    "@aws-sdk/client-s3": "^3.687.0",
    "@aws-sdk/lib-dynamodb": "^3.687.0",
    "@fastify/cors": "^10.0.1",
    "@netra/domain": "workspace:*",
    "aws-jwt-verify": "^5.2.1",
    "fastify": "^5.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.163",
    "@types/node": "^22.9.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
