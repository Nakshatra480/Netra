# Netra repository-analysis sandbox.
#
# Contains only the read-only analysis tools the allowlist permits. There is no
# package manager at runtime, no shell interpreter is ever invoked by Netra, and
# the image runs as an unprivileged user.
FROM alpine:3.21

RUN apk add --no-cache \
      git=~2.47 \
      ripgrep=~14.1 \
 && addgroup -g 10001 netra \
 && adduser -u 10001 -G netra -D -H -s /sbin/nologin netra

# git refuses to operate on a repository owned by another uid; the workspace is
# mounted read-only and is safe to analyse.
RUN git config --system --add safe.directory /workspace

USER 10001:10001
WORKDIR /workspace

# Overridden by the executor; present so the image is usable standalone.
ENTRYPOINT []
CMD ["sleep", "3600"]
