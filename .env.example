# ============================================================
# Netra environment configuration
# Copy to .env (server) / apps/web/.env.local (client) and fill in.
# NEVER commit filled-in copies. See README "Environment variables".
# ============================================================

# ---------- Model providers (server-side only) ----------
# Netra routes model calls through a provider-agnostic router:
#   OpenRouter (preferred remote)  ->  Ollama (local fallback)  ->  deterministic only
# Neither provider is required. With no model configured, investigations still
# produce verified deterministic findings and the UI says the model was absent.

# OpenRouter. SECRET -- production reads this from AWS Secrets Manager.
# A comma- or newline-separated list of authorized keys used as a RELIABILITY
# failover pool: a key that reports a rate limit is rested with backoff, and a
# key whose budget is exhausted is retired. Each account is used within its own
# allowance; this is not a way around any provider's limits.
OPENROUTER_API_KEYS=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Server-side model allowlist per tier, strongest first. A model name can never
# come from user input or from a model -- only from here.
# OPENROUTER_MODELS_DEEP=anthropic/claude-opus-4.5,anthropic/claude-sonnet-4.5
# OPENROUTER_MODELS_STANDARD=anthropic/claude-sonnet-4.5,deepseek/deepseek-v4-flash-0731:free
# OPENROUTER_MODELS_FAST=anthropic/claude-haiku-4.5,z-ai/glm-5.2:free

# Ollama local fallback. Developer/demo only -- Netra does not deploy Ollama to
# AWS, because a hosted GPU runtime would cost more than the rest of the system.
# Run `netra-investigate doctor` to see what is installed and what is missing.
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
# Must also be in Netra's capable-model allowlist; unapproved models are ignored.
OLLAMA_MODEL=

# Token and cost guardrails. Reaching a limit ends the model's participation,
# not the investigation: deterministic analysis still produces the finding.
MAX_MODEL_TURNS=4
MAX_INPUT_TOKENS=60000
MAX_OUTPUT_TOKENS=1500
MAX_INVESTIGATION_TOKENS=80000
MAX_INVESTIGATION_COST_USD=0.25
MAX_FRAGMENT_TOKENS=4000

# ---------- AWS (server-side only) ----------
AWS_REGION=eu-north-1
NETRA_STAGE=dev
# Created by the SAM stack; read from CloudFormation outputs.
NETRA_TABLE_NAME=netra-dev-main
NETRA_ARTIFACTS_BUCKET=
NETRA_EVENT_BUS_NAME=netra-dev-bus
NETRA_STATE_MACHINE_ARN=

# ---------- Amazon Cognito ----------
# Created by the SAM stack; read from its CloudFormation outputs.
# These identifiers are PUBLIC by design: they name the user pool and app
# client, and grant nothing on their own. Authorization comes from the access
# token's verified claims, which the API checks server-side on every request.
NETRA_COGNITO_USER_POOL_ID=
NETRA_COGNITO_CLIENT_ID=

# The same two values, exposed to the browser bundle.
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=

# ---------- GitHub App (server-side only, SECRET) ----------
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# PEM contents, \n-escaped. Production: AWS Secrets Manager.
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------- Frontend ----------
VITE_API_BASE_URL=http://localhost:8787
# Enables the no-auth demo investigation path.
VITE_DEMO_MODE_ENABLED=true

# ---------- Sandbox ----------
# Docker image used for isolated repository analysis.
NETRA_SANDBOX_IMAGE=netra-sandbox:latest
NETRA_SANDBOX_TIMEOUT_MS=120000
NETRA_SANDBOX_MEMORY_MB=512
