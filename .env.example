# ============================================================
# Netra environment configuration
# Copy to .env (server) / apps/web/.env.local (client) and fill in.
# NEVER commit filled-in copies. See README "Environment variables".
# ============================================================

# ---------- Model gateway: AgentRouter (server-side only, SECRET) ----------
# AgentRouter is an external model gateway, not part of the AWS platform. It is
# the only component outside AWS that sees investigation context.
# Production: store the key in AWS Secrets Manager, never in this file.
AI_PROVIDER=agentrouter
# One of: claude-sonnet-4-5-20250929 | claude-opus-4-5-20251101 | claude-haiku-4-5-20251001
AI_MODEL=claude-sonnet-4-5-20250929
AGENTIC_API_BASE_URL=https://api.agentrouter.to/api/agentic-api
AGENTIC_API_KEY=
AGENTROUTER_ROUTE_KEY=models.chat.complete.anthropic.messages.mpp

# Cost control. AgentRouter reserves credits against the requested max_tokens,
# so a turn costs roughly 8 credits (~$0.008) at these settings.
# 1000 credits = $1. An investigation that hits the ceiling still completes on
# deterministic analysis alone, and says so.
NETRA_MAX_AGENT_ITERATIONS=6
NETRA_MAX_OUTPUT_TOKENS=1200
NETRA_MAX_COST_UNITS=60
NETRA_MAX_TOOL_RESULT_CHARS=2500

# ---------- AWS (server-side only) ----------
AWS_REGION=eu-north-1
NETRA_STAGE=dev
# Created by the SAM stack; read from CloudFormation outputs.
NETRA_TABLE_NAME=netra-dev-main
NETRA_ARTIFACTS_BUCKET=
NETRA_EVENT_BUS_NAME=netra-dev-bus
NETRA_STATE_MACHINE_ARN=

# ---------- Firebase Admin (server-side only, SECRET) ----------
# Prefer AWS Secrets Manager in production; this is for local dev only.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Single-line, \n-escaped private key. Never place in source or Git.
FIREBASE_PRIVATE_KEY=

# ---------- Firebase Web SDK (PUBLIC — safe in the browser bundle) ----------
# These are public client identifiers by design; access is controlled by
# Firebase Auth rules + server-side ID-token verification.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# ---------- GitHub App (server-side only, SECRET) ----------
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# PEM contents, \n-escaped. Production: AWS Secrets Manager.
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------- Frontend ----------
VITE_API_BASE_URL=http://localhost:8787
# Enables the no-auth demo investigation path.
VITE_DEMO_MODE_ENABLED=true

# ---------- Sandbox ----------
# Docker image used for isolated repository analysis.
NETRA_SANDBOX_IMAGE=netra-sandbox:latest
NETRA_SANDBOX_TIMEOUT_MS=120000
NETRA_SANDBOX_MEMORY_MB=512
