# Copy this file to .env.local and fill in the values for your deployment.
# None of these are secrets — they are public AWS resource identifiers.
# The Google client secret lives only in Cognito; never put it here.

# Netra approval endpoint (separate API).
# Approving launches the remediation task, which the read API has no permission
# to do. From the deployed stack: `ApprovalApiUrl` output.
VITE_APPROVAL_API_URL=https://<approval-api-id>.execute-api.<region>.amazonaws.com/<stage>

# Netra API Gateway endpoint
VITE_API_BASE_URL=https://<api-id>.execute-api.<region>.amazonaws.com

# Cognito User Pool (public config, not a secret)
VITE_COGNITO_USER_POOL_ID=<region>_<pool-id>
VITE_COGNITO_CLIENT_ID=<app-client-id>
VITE_COGNITO_DOMAIN=https://<domain-prefix>.auth.<region>.amazoncognito.com
